CHART_JS = """
function fmt(s){if(s>=86400)return (s/86400).toFixed(1).replace('.',',')+' дн';
 if(s>=3600){var h=Math.floor(s/3600),m=Math.floor(s%3600/60);return h+'ч '+(m<10?'0':'')+m+'м'}
 if(s<30)return '<1 мин';return Math.min(59,Math.max(1,Math.round(s/60)))+' мин'}
function esc(t){return String(t).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function rows(list,withArtist,onClick){if(!list.length)return '<div class="empty">Пока пусто</div>';
 var max=list[0][2]||1,total=list.reduce(function(a,r){return a+r[2]},0)||1;
 return list.map(function(r,i){return '<div class="row'+(onClick?' link':'')+'" data-i="'+i+'"><div class="rank">'+(i+1)+'</div><div class="main"><div class="t">'+esc(r[1])+'</div>'
  +(withArtist?'<div class="a">'+esc(r[0])+'</div>':'')+'<div class="share" style="width:'+Math.max(2,r[2]/max*100)+'%"></div></div><div class="val">'+fmt(r[2])+' · '+Math.round(r[2]*100/total)+'%</div></div>'}).join('')}
function chart(el,vals,labels,onBar){var W=800,H=240,pad=28,n=vals.length,max=Math.max.apply(null,vals.concat([1])),bw=(W-pad*2)/n;
 var s='<svg viewBox="0 0 '+W+' '+(H+24)+'">';
 for(var g=1;g<=3;g++){var y=H-(H-20)*g/3;s+='<line x1="'+pad+'" x2="'+(W-pad)+'" y1="'+y+'" y2="'+y+'" stroke="currentColor" stroke-opacity=".08"/><text class="axis" x="2" y="'+(y+4)+'">'+fmt(max*g/3)+'</text>'}
 for(var i=0;i<n;i++){var h=vals[i]?Math.max(3,(H-20)*vals[i]/max):0,x=pad+i*bw+bw*0.15;
  s+='<rect class="bar" data-i="'+i+'" x="'+x+'" y="'+(H-h)+'" width="'+bw*0.7+'" height="'+h+'" rx="4"><title>'+esc(labels.full[i])+': '+fmt(vals[i])+'</title></rect>';
  s+='<text class="axis" text-anchor="middle" x="'+(x+bw*0.35)+'" y="'+(H+16)+'">'+esc(labels.short[i])+'</text>'}
 el.innerHTML=s+'</svg>';
 el.querySelectorAll('.bar').forEach(function(b){b.onclick=function(){var i=+b.dataset.i;el.querySelectorAll('.bar').forEach(function(o){o.classList.toggle('dim',o!==b)});onBar(i)}})}
"""


def _page(title, body, script):
    return ("<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\">"
            "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
            "<title>%s</title><style>%s</style></head><body><div class=\"wrap\">%s</div>"
            "<script>%s\n%s</script></body></html>") % (html.escape(title), PAGE_CSS, body, CHART_JS, script)


def _json(value):
    return json.dumps(value, ensure_ascii=False).replace("</", "<\\/")


# ───────────────────────── Плагин ─────────────────────────

class MusicStatsDesktopPlugin(BasePlugin):
    def on_plugin_load(self):
        base = get_files_dir()
        os.makedirs(base, exist_ok=True)
        self.pages_dir = os.path.join(base, "music_stats_pages")
        os.makedirs(self.pages_dir, exist_ok=True)
        self.store = Store(os.path.join(base, "music_stats.db"))
        self.cur = None           # (artist, title, duration) — даже на паузе
        self.position = 0.0
        self.paused = False
        self._dur_seen = {}
        self._artwork = {}
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._loop, name="MusicStatsLoop", daemon=True)
        self._thread.start()
        self.add_on_send_message_hook()
        for text, fn in (("Музыка: статистика", self.open_stats),
                         ("Музыка: текст песни", self.open_lyrics),
                         ("Музыка: статистика трека", self.open_current_track_stats)):
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.DRAWER_MENU, text=text,
                                            on_click=lambda *a, f=fn, **k: f()))
        log("music stats loaded")

    def on_plugin_unload(self):
        self._stop.set()
        self.store.flush()

    # ----- команды -----
    def on_send_message_hook(self, account, params):
        low = str(getattr(params, "message", "") or "").strip().lower()
        actions = {
            ".music": self.open_stats, ".музыка": self.open_stats,
            ".lyrics": self.open_lyrics, ".текст": self.open_lyrics,
            ".track": self.open_current_track_stats, ".трек": self.open_current_track_stats,
        }
        action = actions.get(low)
        if action is None:
            return HookResult()
        action()
        return HookResult(strategy=HookStrategy.CANCEL)

    # ----- фоновый учёт -----
    def _loop(self):
        last = time.monotonic()
        last_flush = last
        while not self._stop.wait(1.0):
            now = time.monotonic()
            dt = min(now - last, 2.0)
            last = now
            try:
                info = get_now_playing()
                if info:
                    artist, title, dur = track_from_player(info)
                    self.cur = (artist, title, dur)
                    self.position = float(info.get("position") or 0.0)
                    self.paused = bool(info.get("paused"))
                    if self.get_setting("enabled", True):
                        if dur > 0 and self._dur_seen.get((artist, title)) != dur:
                            self._dur_seen[(artist, title)] = dur
                            self.store.set_duration(artist, title, dur)
                        if not self.paused:
                            self.store.add(int(time.time() // 60 * 60), artist, title, dt)
                else:
                    self.cur = None
                    self.paused = False
            except Exception as e:
                log("tick error: %r" % (e,))
            if now - last_flush >= 10:
                last_flush = now
                self.store.flush()
        self.store.flush()

    # ----- страницы -----
    def _write_and_open(self, name, content):
        path = os.path.join(self.pages_dir, name)
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
        open_url("file:///" + path.replace("\\", "/"))

    def _in_background(self, fn):
        def work():
            try:
                fn()
            except Exception as e:
                log("music stats page error: %r" % (e,))
                toast("MusicStats: ошибка, подробности в консоли плагинов")
        threading.Thread(target=work, daemon=True).start()

    def _cover(self, artist, title):
        if not self.get_setting("covers", True):
            return None
        key = (artist, title)
        if key not in self._artwork:
            self._artwork[key] = fetch_artwork(artist, title)
        return self._artwork[key]

    def open_stats(self):
        self._in_background(self._build_stats)

    def _build_stats(self):
        snap = self.store.snapshot()
        modes = {}
        for mode in ("hour", "wday", "month"):
            title, vals, labels, buckets = build_series(snap, mode)
            modes[mode] = {
                "title": title, "vals": vals,
                "labels": {"short": labels, "full": [b["label"] for b in buckets]},
                "tracks": [[list(r) for r in self.store.tracks_for_bucket(b)[:15]] for b in buckets],
            }
        artists = {a: [list(r) for r in self.store.tracks_for_artist(a)[:15]] for a, _ in snap["top_artists"]}
        now_html = ""
        if self.cur:
            artist, title, _ = self.cur
            cover = self._cover(artist, title)
            now_html = ('<div class="card now">%s<div><div class="lbl">%s</div><h2>%s</h2>'
                        '<div class="sub">%s</div></div></div>') % (
                '<img class="cover" src="%s">' % html.escape(cover) if cover else "",
                "На паузе" if self.paused else "Сейчас играет",
                html.escape(title), html.escape(artist))
        cards = "".join('<div><div class="num">%s</div><div class="lbl">%s</div></div>' % (v, l) for v, l in (
            (fmt_smart(snap["today"]), "сегодня"), (fmt_smart(snap["week"]), "за 7 дней"),
            (fmt_smart(snap["month"]), "за 30 дней"), (fmt_smart(snap["total"]), "всего"),
            (str(snap["tracks"]), "разных треков")))
        body = (
            '<h1>Статистика музыки</h1><div class="sub">Обновлено %s · Femboy Music Stats</div>%s'
            '<div class="card"><div class="grid">%s</div></div>'
            '<div class="card"><div class="pills" id="modes"></div><h2 id="ctitle"></h2><div id="chart"></div>'
            '<div id="bucket" style="margin-top:12px"></div></div>'
            '<div class="card"><h2>Топ треков</h2><div id="tracks"></div></div>'
            '<div class="card"><h2>Топ исполнителей</h2><div id="artists"></div><div id="artist" style="margin-top:12px"></div></div>'
        ) % (time.strftime("%d.%m.%Y %H:%M"), now_html, cards)
        script = (
            "var M=%s,TT=%s,TA=%s,AR=%s,names={hour:'24 часа',wday:'Дни недели',month:'12 месяцев'};"
            "function show(m){var d=M[m];document.getElementById('ctitle').textContent=d.title;"
            "document.querySelectorAll('.pill').forEach(function(p){p.classList.toggle('on',p.dataset.m===m)});"
            "document.getElementById('bucket').innerHTML='<div class=\"sub\">Нажмите на столбец, чтобы увидеть треки</div>';"
            "chart(document.getElementById('chart'),d.vals,d.labels,function(i){"
            "document.getElementById('bucket').innerHTML='<h2>'+esc(d.labels.full[i])+'</h2>'+rows(d.tracks[i],true)})}"
            "document.getElementById('modes').innerHTML=Object.keys(names).map(function(k){return '<button class=\"pill\" data-m=\"'+k+'\">'+names[k]+'</button>'}).join('');"
            "document.querySelectorAll('.pill').forEach(function(p){p.onclick=function(){show(p.dataset.m)}});show('hour');"
            "document.getElementById('tracks').innerHTML=rows(TT,true);"
            "var al=TA.map(function(r){return [r[0],r[0],r[1]]});var ae=document.getElementById('artists');ae.innerHTML=rows(al,false,true);"
            "ae.querySelectorAll('.row').forEach(function(r){r.onclick=function(){var a=al[+r.dataset.i][0];"
            "document.getElementById('artist').innerHTML='<h2>'+esc(a)+'</h2>'+rows(AR[a]||[],false)}});"
        ) % (_json(modes), _json([list(r) for r in snap["top_tracks"]]), _json([list(r) for r in snap["top_artists"]]), _json(artists))
        self._write_and_open("stats.html", _page("Статистика музыки", body, script))

    def open_current_track_stats(self):
        if not self.cur:
            toast("Сейчас ничего не играет")
            return
        artist, title, dur = self.cur
        self.open_track_stats(artist, title, dur)

    def open_track_stats(self, artist, title, duration=0):
        self._in_background(lambda: self._build_track(artist, title, duration))

    def _build_track(self, artist, title, duration):
        ts = self.store.track_stats(artist, title)
        dur = ts["duration"] or duration
        hod, wd, moy = [0.0] * 24, [0.0] * 7, [0.0] * 12
        for h, secs in ts["hourly"]:
            lt = time.localtime(h)
            hod[lt.tm_hour] += secs
            wd[lt.tm_wday] += secs
            moy[lt.tm_mon - 1] += secs
        modes = {
            "hour": {"title": "По времени суток · всё время", "vals": hod,
                     "labels": {"short": ["%02d" % i if i % 3 == 0 else "" for i in range(24)],
                                "full": ["%02d:00–%02d:00" % (i, (i + 1) % 24) for i in range(24)]}},
            "wday": {"title": "По дням недели · всё время", "vals": wd,
                     "labels": {"short": WDAYS, "full": WDAYS_PLURAL}},
            "month": {"title": "По месяцам года · всё время", "vals": moy,
                      "labels": {"short": MONTHS, "full": MONTHS_FULL}},
        }
        plays = (ts["total"] / dur) if dur else 0
        facts = [(fmt_hms(ts["total"]), "всего прослушано")]
        if dur:
            facts.append(("%.1f" % plays, "прослушиваний (≈)"))
            facts.append(("%d:%02d" % divmod(int(dur), 60), "длительность"))
        if ts["first"]:
            facts.append((fmt_date(ts["first"]), "впервые"))
            facts.append((fmt_date(ts["last"]), "последний раз"))
        cover = self._cover(artist, title)
        body = (
            '<div class="card now">%s<div><div class="lbl">Статистика трека</div><h1>%s</h1><div class="sub">%s</div></div></div>'
            '<div class="card"><div class="grid">%s</div></div>'
            '<div class="card"><div class="pills" id="modes"></div><h2 id="ctitle"></h2><div id="chart"></div></div>'
        ) % ('<img class="cover" src="%s">' % html.escape(cover) if cover else "", html.escape(title), html.escape(artist),
             "".join('<div><div class="num">%s</div><div class="lbl">%s</div></div>' % f for f in facts))
        script = (
            "var M=%s,names={hour:'Время суток',wday:'Дни недели',month:'Месяцы'};"
            "function show(m){var d=M[m];document.getElementById('ctitle').textContent=d.title;"
            "document.querySelectorAll('.pill').forEach(function(p){p.classList.toggle('on',p.dataset.m===m)});"
            "chart(document.getElementById('chart'),d.vals,d.labels,function(){})}"
            "document.getElementById('modes').innerHTML=Object.keys(names).map(function(k){return '<button class=\"pill\" data-m=\"'+k+'\">'+names[k]+'</button>'}).join('');"
            "document.querySelectorAll('.pill').forEach(function(p){p.onclick=function(){show(p.dataset.m)}});show('hour');"
        ) % _json(modes)
        self._write_and_open("track.html", _page("%s — %s" % (artist, title), body, script))

    def open_lyrics(self):
        if not self.cur:
            toast("Сейчас ничего не играет")
            return
        artist, title, dur = self.cur
        position, paused = self.position, self.paused
        toast("Ищу текст песни…")
        self._in_background(lambda: self._build_lyrics(artist, title, dur, position, paused))

    def _build_lyrics(self, artist, title, duration, position, paused):
        res = fetch_lyrics(artist, title, duration)
        if res["status"] != "ok":
            toast("Текст песни «%s» не найден" % title)
            return
        cover = self._cover(artist, title)
        head = ('<div class="card now">%s<div><div class="lbl">Текст песни · LRCLIB</div><h1>%s</h1><div class="sub">%s</div></div></div>') % (
            '<img class="cover" src="%s">' % html.escape(cover) if cover else "", html.escape(title), html.escape(artist))
        if res["lines"]:
            body = head + '<div class="card lyr" id="lyr">%s</div><div class="sub">Подсветка идёт от позиции трека в момент открытия%s.</div>' % (
                "".join('<p data-t="%.2f">%s</p>' % (t, html.escape(line)) for t, line in res["lines"]),
                " (трек был на паузе)" if paused else "")
            script = (
                "var start=%.3f,opened=Date.now(),run=%s,ps=[].slice.call(document.querySelectorAll('#lyr p')),last=-1;"
                "function tick(){var t=start+(run?(Date.now()-opened)/1000:0),i=-1;"
                "for(var k=0;k<ps.length;k++){if(+ps[k].dataset.t<=t)i=k;else break}"
                "if(i!==last){if(last>=0)ps[last].classList.remove('cur');if(i>=0){ps[i].classList.add('cur');"
                "ps[i].scrollIntoView({block:'center',behavior:'smooth'})}last=i}}setInterval(tick,250);tick();"
            ) % (position, "false" if paused else "true")
        else:
            body = head + '<div class="card lyr"><pre>%s</pre></div>' % html.escape(res["plain"] or "")
            script = ""
        self._write_and_open("lyrics.html", _page("%s — %s" % (artist, title), body, script))

    # ----- настройки -----
    def create_settings(self):
        return [
            Header(text="Статистика прослушивания"),
            Switch(key="enabled", text="Вести учёт", default=True,
                   subtext="Считается музыка из плеера Telegram, без голосовых и кружков"),
            Switch(key="covers", text="Обложки из iTunes", default=True,
                   subtext="Подставлять обложки треков на страницах статистики"),
            Text(text="Открыть статистику", accent=True, on_click=lambda *a: self.open_stats()),
            Text(text="Открыть текст песни", accent=True, on_click=lambda *a: self.open_lyrics()),
            Text(text="Статистика текущего трека", accent=True, on_click=lambda *a: self.open_current_track_stats()),
            Text(text="Сбросить все данные", red=True, on_click=lambda *a: self.confirm_reset()),
            Divider(text="Команды в любом чате: .music статистика, .lyrics текст песни, .track статистика трека. "
                         "Пункты есть и в боковом меню. Страницы открываются в браузере."),
        ]

    def confirm_reset(self):
        builder = AlertDialogBuilder()
        builder.set_title("Сбросить статистику")
        builder.set_message("Удалить всю историю прослушиваний? Это нельзя отменить.")
        builder.set_positive_button("Сбросить", lambda b, w: (self.store.reset(), toast("Статистика сброшена")))
        builder.set_negative_button("Отмена", lambda b, w: None)
        builder.show()
